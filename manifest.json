{
    "manifest_version": 3,
    "name": "AWS Production Account Highlighter",
    "version": "1.0.2",
    "description": "AWS本番アカウントのヘッダーを赤色で強調表示します",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "{5388CE81-7AEC-4FEB-BCE1-0FBC6045E4A7}",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    },
    "content_scripts": [
        {
            "matches": [
                "https://*.console.aws.amazon.com/*",
                "https://console.aws.amazon.com/*"
            ],
            "js": [
                "config.js",
                "content.js"
            ],
            "run_at": "document_end"
        }
    ],
    "permissions": []
}